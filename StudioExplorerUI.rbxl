	HorizontalAlignment = Enum.HorizontalAlignment.Left,
	VerticalAlignment = Enum.VerticalAlignment.Center,
	Padding = UDim.new(0, 0),
	Parent = bar,
})

local toolbarItems = {}

local function addItem(frame, fullW, compactW, apply)
	frame.LayoutOrder = #toolbarItems + 1
	table.insert(toolbarItems, { frame = frame, fullW = fullW, compactW = compactW, apply = apply })
end

local function toolbarWidth(compact)
	local w = 16 -- padding lateral da barra
	for _, item in ipairs(toolbarItems) do
		w = w + (compact and item.compactW or item.fullW)
	end
	return w
end

local function setToolbarMode(compact)
	local barH = compact and METRICS.BarCompactH or METRICS.BarFullH
	for _, item in ipairs(toolbarItems) do
		item.frame.Size = UDim2.fromOffset(compact and item.compactW or item.fullW, barH)
		if item.apply then
			item.apply(compact)
		end
	end
end

local function addTool(label, drawFn)
	local f = create("Frame", { Name = label, BackgroundTransparency = 1, BorderSizePixel = 0, Parent = bar })
	local iconHolder = create("Frame", {
		Name = "IconHolder",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(30, 30),
		Parent = f,
	})
	buildIcon(iconHolder, drawFn, 30)
	local lbl = create("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -6),
		Size = UDim2.new(1, 0, 0, 18),
		Text = label,
		Font = Enum.Font.GothamMedium,
		TextSize = 15,
		TextColor3 = THEME.text,
		Parent = f,
	})
	addItem(f, 78, 42, function(compact)
		if compact then
			iconHolder.Position = UDim2.fromScale(0.5, 0.5)
		else
			iconHolder.Position = UDim2.new(0.5, 0, 0, 24)
		end
		lbl.Visible = not compact
	end)
end

local function addSeparator(strong)
	local f = create("Frame", { Name = "Separator", BackgroundTransparency = 1, BorderSizePixel = 0, Parent = bar })
	create("Frame", {
