<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Meta name="ExplicitAutoJoints">true</Meta>
	<Item class="Workspace" referent="RBX0">
		<Properties>
			<string name="Name">Workspace</string>
		</Properties>
		<Item class="Part" referent="RBX1">
			<Properties>
				<string name="Name">Baseplate</string>
				<bool name="Anchored">true</bool>
				<Vector3 name="size"><X>512</X><Y>20</Y><Z>512</Z></Vector3>
				<CoordinateFrame name="CFrame"><X>0</X><Y>-10</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame>
			</Properties>
		</Item>
		<Item class="SpawnLocation" referent="RBX2">
			<Properties>
				<string name="Name">SpawnLocation</string>
				<bool name="Anchored">true</bool>
				<Vector3 name="size"><X>12</X><Y>1</Y><Z>12</Z></Vector3>
				<CoordinateFrame name="CFrame"><X>0</X><Y>0.5</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame>
			</Properties>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX3">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX4">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBX5">
				<Properties>
					<string name="Name">StudioExplorerUI</string>
					<bool name="Disabled">false</bool>
					<token name="RunContext">0</token>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	================================================================
	 STUDIO EXPLORER UI  -  LocalScript (Luau)  -  prioridade Mobile
	================================================================

	INSTALACAO
		Coloque este script como um LocalScript em:
		StarterPlayer > StarterPlayerScripts

	O QUE ELE FAZ
		* Recria a interface do Roblox Studio da imagem de referencia:
		  barra de ferramentas (Select / Move / Scale / Rotate / snaps /
		  Part / Terrain / UI / martelo / engrenagem / plugins),
		  painel Explorer, painel Properties e a aba "<" lateral.
		* Todos os icones sao desenhados por codigo (Frames + UICorner +
		  UIStroke). Nenhum asset externo e necessario.
		* FUNCIONALIDADE (somente a barra lateral Explorer):
			- Arrastar horizontalmente para os lados: pelo cabecalho,
			  pelo painel Properties, pela aba lateral, ou deslizando o
			  dedo na horizontal sobre a propria lista.
			- Rolagem vertical por toque (com inercia) e barra de rolagem
			  grossa/azul. Gesto vertical rola a lista; gesto horizontal
			  move o painel (o script decide pelo eixo do gesto).
			- Ao soltar, o painel "gruda" nas bordas. Tocar na aba
			  lateral recolhe/expande o painel.
			- Setas das linhas expandem/recolhem filhos (mais conteudo
			  para rolar) e tocar numa linha a destaca.
		* Responsivo: escala automatica pelo menor lado da tela, toolbar
		  em modo compacto (so icones) quando falta espaco, layout
		  empilhado em telas estreitas (retrato) e reajuste ao girar.

	AJUSTES RAPIDOS: veja a tabela CONFIG logo abaixo.
]]

----------------------------------------------------------------------
-- 1. SERVICOS, CONFIGURACAO, TEMA
----------------------------------------------------------------------
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local oldGui = playerGui:FindFirstChild("StudioExplorerUI")
if oldGui then
	oldGui:Destroy()
end

local CONFIG = {
	WhiteBackdrop = false, -- true = fundo branco como na imagem de referencia
	TapSlop = 10,          -- pixels reais de tolerancia para diferenciar toque de arraste
	SnapDistance = 56,     -- distancia (px de design) para "grudar" nas bordas
	HideThreshold = 40,    -- se menos que isso ficar visivel, o painel vira "recolhido"
	TweenTime = 0.22,      -- duracao das animacoes
}

