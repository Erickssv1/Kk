	PanelRadius = 18,
}

----------------------------------------------------------------------
-- 2. FUNCOES AUXILIARES
----------------------------------------------------------------------
local function create(className, props)
	local inst = Instance.new(className)
	local parent = nil
	for key, value in pairs(props) do
		if key == "Parent" then
			parent = value
		else
			inst[key] = value
		end
	end
	inst.Parent = parent
	return inst
end

local function corner(parent, radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end

local function stroke(parent, color, thickness, transparency)
	return create("UIStroke", {
		Color = color,
		Thickness = thickness,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

-- Brilho azul suave ao redor dos paineis (como na referencia)
local function addGlow(frame, radius)
	local glow = create("Frame", {
		Name = "Glow",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(-2, -2),
		Size = UDim2.new(1, 4, 1, 4),
		Parent = frame,
	})
	corner(glow, radius + 2)
	stroke(glow, THEME.accent, 7, 0.8)
end

----------------------------------------------------------------------
-- 3. BIBLIOTECA DE ICONES (desenhados por codigo, grade de 28x28)
----------------------------------------------------------------------
-- newCanvas cria uma area quadrada e devolve funcoes de desenho que
-- trabalham numa grade fixa de 28 unidades (escalavel para qualquer tamanho).
local function newCanvas(parent, size)
	local k = size / 28
	local canvas = create("Frame", {
		Name = "Icon",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		Parent = parent,
	})

	local d = {}

	function d.rect(x, y, w, h, color, radius)
		local f = create("Frame", {
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(x * k, y * k),
			Size = UDim2.fromOffset(w * k, h * k),
			Parent = canvas,
		})
		if radius and radius > 0 then
			corner(f, radius * k)
		end
		return f
	end

	function d.dot(cx, cy, r, color)
		local f = create("Frame", {
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(cx * k, cy * k),
			Size = UDim2.fromOffset(2 * r * k, 2 * r * k),
			Parent = canvas,
		})
		create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = f })
		return f
	end

	-- anel: r = raio ate o centro do traco, th = espessura
	function d.ring(cx, cy, r, th, color)
		local inner = math.max(1, 2 * r - th)
		local f = create("Frame", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(cx * k, cy * k),
			Size = UDim2.fromOffset(inner * k, inner * k),
			Parent = canvas,
		})
		create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = f })
		stroke(f, color, th * k)
		return f
	end

	-- retangulo apenas com contorno (x,y,w,h = limites externos)
	function d.box(x, y, w, h, th, color, radius)
		local f = create("Frame", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset((x + th) * k, (y + th) * k),
			Size = UDim2.fromOffset((w - 2 * th) * k, (h - 2 * th) * k),
			Parent = canvas,
		})
		corner(f, math.max(0, (radius or 0) - th) * k)
		stroke(f, color, th * k)
		return f
	end

	function d.line(x1, y1, x2, y2, th, color)
		local dx, dy = x2 - x1, y2 - y1
		local len = math.sqrt(dx * dx + dy * dy)
		local f = create("Frame", {
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((x1 + x2) / 2 * k, (y1 + y2) / 2 * k),
			Size = UDim2.fromOffset((len + th) * k, th * k),
			Rotation = math.deg(math.atan2(dy, dx)),
			Parent = canvas,
		})
		corner(f, th * k / 2)
		return f
	end

	-- "V" com vertice em (ax, ay) apontando para dir
	function d.chevron(ax, ay, arm, dir, th, color)
		local p1, p2
		if dir == "up" then
			p1, p2 = { ax - arm, ay + arm }, { ax + arm, ay + arm }
		elseif dir == "down" then
			p1, p2 = { ax - arm, ay - arm }, { ax + arm, ay - arm }
		elseif dir == "left" then
			p1, p2 = { ax + arm, ay - arm }, { ax + arm, ay + arm }
		else
			p1, p2 = { ax - arm, ay - arm }, { ax - arm, ay + arm }
		end
		d.line(p1[1], p1[2], ax, ay, th, color)
		d.line(ax, ay, p2[1], p2[2], th, color)
	end

	-- poligono preenchido (varredura em faixas horizontais)
	function d.poly(points, color)
		local minY, maxY = math.huge, -math.huge
		for _, p in ipairs(points) do
			minY = math.min(minY, p[2])
			maxY = math.max(maxY, p[2])
		end
		local count = #points
		local y = math.floor(minY)
		while y < maxY do
			local yc = y + 0.5
			local xs = {}
			for i = 1, count do
				local a = points[i]
				local b = points[i % count + 1]
				local ay, by = a[2], b[2]
				if (ay <= yc and by > yc) or (by <= yc and ay > yc) then
					local t = (yc - ay) / (by - ay)
					table.insert(xs, a[1] + t * (b[1] - a[1]))
				end
			end
			table.sort(xs)
			for i = 1, #xs - 1, 2 do
				local x1, x2 = xs[i], xs[i + 1]
				if x2 - x1 > 0.05 then
					d.rect(x1, y, x2 - x1, 1.3, color, 0)
				end
			end
			y = y + 1
		end
	end

	function d.text(str, cx, cy, textSize, color, font)
		return create("TextLabel", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(cx * k, cy * k),
			Size = UDim2.fromOffset(28 * k, 28 * k),
			Text = str,
			TextColor3 = color,
			Font = font or Enum.Font.GothamBold,
			TextSize = math.max(8, math.floor(textSize * k)),
			Parent = canvas,
		})
	end

	return canvas, d
end

local function buildIcon(parent, drawFn, size)
	local canvas, d = newCanvas(parent, size)
	drawFn(d)
	return canvas
end

------------------------------ Icones da toolbar / UI -----------------
local ToolIcons = {}

function ToolIcons.Select(d)
	d.poly({ { 7, 3 }, { 7, 22.5 }, { 11.8, 18.2 }, { 15.2, 25.5 }, { 18.2, 24.2 }, { 14.8, 17 }, { 21.5, 16.6 } }, C.white)
end

function ToolIcons.Move(d)
	d.line(14, 4, 14, 24, 2.4, C.white)
	d.line(4, 14, 24, 14, 2.4, C.white)
	d.chevron(14, 3, 4, "up", 2.4, C.white)
	d.chevron(14, 25, 4, "down", 2.4, C.white)
	d.chevron(3, 14, 4, "left", 2.4, C.white)
	d.chevron(25, 14, 4, "right", 2.4, C.white)
end

function ToolIcons.Scale(d)
	d.box(3, 9, 17, 17, 2.4, C.white, 3)
	d.line(9, 19, 24, 4, 2.4, C.white)
	d.line(15.5, 4, 24, 4, 2.4, C.white)
	d.line(24, 4, 24, 12.5, 2.4, C.white)
end

function ToolIcons.Rotate(d)
	d.ring(14, 14, 10, 2.4, C.white)
	d.dot(14, 14, 2.6, C.white)
	d.chevron(18, 4.4, 3.2, "right", 2.4, C.white)
end

function ToolIcons.Part(d)
	local p = { { 14, 2.5 }, { 24.5, 8 }, { 24.5, 20 }, { 14, 25.5 }, { 3.5, 20 }, { 3.5, 8 } }
	for i = 1, 6 do
		local a, b = p[i], p[i % 6 + 1]
		d.line(a[1], a[2], b[1], b[2], 2.4, C.white)
	end
	d.line(14, 14, 3.5, 8, 2.4, C.white)
	d.line(14, 14, 24.5, 8, 2.4, C.white)
	d.line(14, 14, 14, 25.5, 2.4, C.white)
end

function ToolIcons.Terrain(d)
	d.box(3, 4, 22, 20, 2.4, C.white, 4)
	d.poly({ { 6, 21 }, { 11, 12.5 }, { 14.5, 18 }, { 17.5, 14 }, { 22, 21 } }, C.white)
	d.dot(19.5, 9.5, 2.2, C.white)
end

function ToolIcons.UI(d)
	d.text("T", 14, 14, 34, C.white, Enum.Font.GothamBold)
end

function ToolIcons.Hammer(d)
	d.line(5, 24, 17, 12, 4.4, C.white)
	d.line(11, 5, 23, 17, 7, C.white)
end

function ToolIcons.Gear(d)
	d.ring(14, 14, 7, 4.6, C.white)
	for i = 0, 7 do
		local a = math.rad(i * 45)
		local cs, sn = math.cos(a), math.sin(a)
		d.line(14 + cs * 8.4, 14 + sn * 8.4, 14 + cs * 11.6, 14 + sn * 11.6, 4.2, C.white)
	end
end

function ToolIcons.Puzzle(d)
	d.rect(4, 9, 17, 17, C.white, 2.5)
	d.dot(12.5, 7.5, 3.6, C.white)
	d.dot(22.5, 17.5, 3.6, C.white)
	d.dot(4, 17.5, 3.2, THEME.button)
end

function ToolIcons.Search(d)
	d.ring(11.5, 11.5, 7, 2.5, C.white)
	d.line(17, 17, 24.5, 24.5, 3, C.white)
end

function ToolIcons.Expand(d)
	d.line(5.5, 22.5, 22.5, 5.5, 2.4, C.white)
	d.line(14, 5, 23, 5, 2.4, C.white)
	d.line(23, 5, 23, 14, 2.4, C.white)
	d.line(5, 14, 5, 23, 2.4, C.white)
	d.line(5, 23, 14, 23, 2.4, C.white)
end

function ToolIcons.ChevronDown(d)
	d.chevron(14, 17, 7, "down", 2.6, C.white)
end

function ToolIcons.ChevronLeft(d)
	d.chevron(10, 14, 7, "left", 3, C.white)
end

function ToolIcons.ChevronRight(d)
	d.chevron(18, 14, 7, "right", 3, C.white)
end

function ToolIcons.Info(d)
	d.ring(14, 14, 11.5, 2.2, THEME.info)
	d.dot(14, 8.3, 1.5, THEME.info)
	d.line(14, 12.3, 14, 20, 2.4, THEME.info)
end

function ToolIcons.ArrowRight(d)
	d.poly({ { 9, 6 }, { 9, 22 }, { 21, 14 } }, C.white)
end

function ToolIcons.ArrowDown(d)
	d.poly({ { 6, 9 }, { 22, 9 }, { 14, 21 } }, C.white)
end

