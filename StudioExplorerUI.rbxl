	panel = Color3.fromRGB(10, 14, 26),
	accent = Color3.fromRGB(26, 140, 255),
	barStroke = Color3.fromRGB(34, 44, 76),
	text = Color3.fromRGB(245, 247, 252),
	rowSelected = Color3.fromRGB(26, 62, 122),
	separator = Color3.fromRGB(46, 54, 80),
