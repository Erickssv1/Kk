	addItem(f, strong and 14 or 11, strong and 10 or 7)
end

local function addSnapGroup()
	local f = create("Frame", { Name = "SnapControls", BackgroundTransparency = 1, BorderSizePixel = 0, Parent = bar })
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 4),
		Parent = f,
	})

	local rows = {}
	local function makeRow(order, drawFn, value)
		local row = create("Frame", {
			Name = "Row" .. order,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			LayoutOrder = order,
			Size = UDim2.new(1, -8, 0, 28),
			Parent = f,
		})
		local iconHolder = create("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 2, 0.5, 0),
			Size = UDim2.fromOffset(22, 22),
			Parent = row,
		})
		buildIcon(iconHolder, drawFn, 22)
		local field = create("Frame", {
			BackgroundColor3 = THEME.field,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(32, 0),
			Size = UDim2.new(1, -32, 1, 0),
			Parent = row,
		})
		corner(field, 9)
		stroke(field, THEME.fieldStroke, 1.5)
		local valueLabel = create("TextLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -24, 1, 0),
			Text = value,
			Font = Enum.Font.GothamBold,
			TextSize = 17,
			TextColor3 = THEME.text,
			Parent = field,
		})
		local chevHolder = create("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -5, 0.5, 0),
			Size = UDim2.fromOffset(16, 16),
			Parent = field,
		})
		buildIcon(chevHolder, ToolIcons.ChevronDown, 16)
		table.insert(rows, { row = row, label = valueLabel })
	end
	makeRow(1, ToolIcons.Move, "1")
	makeRow(2, ToolIcons.Rotate, "5")

	addItem(f, 150, 112, function(compact)
		for _, r in ipairs(rows) do
			r.row.Size = UDim2.new(1, -8, 0, compact and 22 or 28)
			r.label.TextSize = compact and 15 or 17
		end
	end)
end

