	white = Color3.fromRGB(255, 255, 255),
	blue = Color3.fromRGB(38, 140, 255),
	blueDark = Color3.fromRGB(28, 96, 200),
	blueLight = Color3.fromRGB(120, 190, 255),
	green = Color3.fromRGB(64, 200, 96),
	greenLight = Color3.fromRGB(150, 228, 70),
	yellow = Color3.fromRGB(255, 200, 50),
