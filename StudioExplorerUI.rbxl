----------------------------------------------------------------------
-- 6. LAYOUT RESPONSIVO
----------------------------------------------------------------------
local function measureScreen()
	local size = gui.AbsoluteSize
	if size.X < 50 or size.Y < 50 then
		local cam = workspace.CurrentCamera
		size = cam and cam.ViewportSize or Vector2.new(1280, 720)
	end
	return size
end

local function computeLayout()
	local screen = measureScreen()
	local M = METRICS.Margin

	-- escala pelo menor lado: linhas ~32px em celulares, maiores em tablets
	local scale = math.clamp(math.min(screen.X, screen.Y) / 420, 0.8, 1.35)
	local W, H = screen.X / scale, screen.Y / scale

	local sidebarW = math.min(math.clamp(math.floor(W * 0.30), 280, 340), W - 2 * M)

	-- toolbar: completa, compacta (so icones) ou compacta reduzida
	local fullW, compactW = toolbarWidth(false), toolbarWidth(true)
	local wideAvail = W - sidebarW - 3 * M
	local stacked = wideAvail < compactW * 0.9 -- tela estreita: toolbar em cima, painel abaixo
	local avail = stacked and (W - 2 * M) or wideAvail
	local compact = avail < fullW
	local natural = compact and compactW or fullW
	local ts = math.clamp(avail / natural, 0.55, 1)
	local barH = compact and METRICS.BarCompactH or METRICS.BarFullH
	local tbW, tbH = natural * ts, barH * ts
	local tbX
	if stacked then
		tbX = math.floor((W - tbW) / 2)
	else
		tbX = math.max(M, W - sidebarW - 2 * M - tbW)
	end

	local top = stacked and (M + tbH + M) or M
	local totalH = math.max(260, H - top - M)
	local propH = math.clamp(math.floor(totalH * 0.30), 130, 260)
	local explH = totalH - propH - METRICS.Gap
	if explH < 170 then
		explH = 170
		propH = math.max(100, totalH - explH - METRICS.Gap)
	end

	return {
		scale = scale,
		W = W,
		H = H,
		sidebarW = sidebarW,
		totalH = totalH,
		explH = explH,
		propH = propH,
		top = top,
		compact = compact,
		natural = natural,
		barH = barH,
		ts = ts,
		tbX = tbX,
		tbW = tbW,
		tbH = tbH,
		minX = -sidebarW - 2,
		maxX = W + 2,
	}
end

----------------------------------------------------------------------
-- 7. MOVIMENTO DA BARRA LATERAL (arraste horizontal, encaixe, recolher)
----------------------------------------------------------------------
local L = nil -- layout atual
local state = {
	x = 0,             -- posicao X (px de design) da borda esquerda do painel
	dock = "right",    -- "right" | "left" | "free"
	collapsed = false, -- painel escondido, so a aba aparece
	tabSide = "left",  -- lado do painel em que a aba fica (voltada ao centro)
}
local activeTween = nil
local suppressTapUntil = 0 -- evita "toque fantasma" em linhas apos um arraste

local function dockedX(side)
	if side == "right" then
		return L.W - L.sidebarW - METRICS.Margin
	end
	return METRICS.Margin
end

local function hiddenX(side)
	if side == "right" then
		return L.W + 2
	end
	return -L.sidebarW - 2
end

local function setX(x)
	x = math.clamp(x, L.minX, L.maxX)
	state.x = x
	sidebar.Position = UDim2.fromOffset(x, L.top)
end

local function cancelTween()
	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end
end

local function tweenToX(x)
	cancelTween()
	x = math.clamp(x, L.minX, L.maxX)
	state.x = x
	activeTween = TweenService:Create(
		sidebar,
		TweenInfo.new(CONFIG.TweenTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = UDim2.fromOffset(x, L.top) }
	)
	activeTween:Play()
end

local function updateTab()
	local onLeft = state.tabSide == "left"
	local tabX = onLeft and -(METRICS.TabW + 4) or (L.sidebarW + 4)
	tab.Position = UDim2.fromOffset(tabX, math.floor(L.explH / 2 - METRICS.TabH / 2))
	chevLeft.Visible = onLeft   -- "<" quando o painel esta a direita
	chevRight.Visible = not onLeft
end

-- Chamado ao soltar o painel depois de arrastar
local function settle()
	local center = state.x + L.sidebarW / 2
	state.tabSide = (center < L.W / 2) and "right" or "left"
	local panelSide = (state.tabSide == "left") and "right" or "left"

	local visible = math.min(state.x + L.sidebarW, L.W) - math.max(state.x, 0)
	if visible < CONFIG.HideThreshold then
		state.collapsed = true
		state.dock = panelSide
		tweenToX(hiddenX(panelSide))
	else
		state.collapsed = false
		local target = state.x
		local rightX, leftX = dockedX("right"), dockedX("left")
		if math.abs(state.x - rightX) <= CONFIG.SnapDistance then
			target = rightX
			state.dock = "right"
			state.tabSide = "left"
		elseif math.abs(state.x - leftX) <= CONFIG.SnapDistance then
			target = leftX
			state.dock = "left"
			state.tabSide = "right"
		else
			state.dock = "free"
		end
		tweenToX(target)
	end
	updateTab()
end

local function toggleCollapsed()
	local side = (state.tabSide == "left") and "right" or "left"
	if state.collapsed then
		state.collapsed = false
		state.dock = side
		tweenToX(dockedX(side))
	else
		state.collapsed = true
		state.dock = side
		tweenToX(hiddenX(side))
	end
end

-- Reposiciona o painel segundo o estado atual (apos girar a tela, etc.)
local function placeFromState()
	cancelTween()
	local x
	if state.collapsed then
		local side = (state.tabSide == "left") and "right" or "left"
		x = hiddenX(side)
	elseif state.dock == "right" then
		state.tabSide = "left"
		x = dockedX("right")
	elseif state.dock == "left" then
		state.tabSide = "right"
		x = dockedX("left")
	else
		x = math.clamp(state.x, -L.sidebarW + 80, L.W - 80)
		state.tabSide = ((x + L.sidebarW / 2) < L.W / 2) and "right" or "left"
	end
	setX(x)
end

local function applyLayout()
	L = computeLayout()
	uiScale.Scale = L.scale
	root.Size = UDim2.fromOffset(L.W, L.H)

	setToolbarMode(L.compact)
	toolbarHolder.Position = UDim2.fromOffset(L.tbX, METRICS.Margin)
	toolbarHolder.Size = UDim2.fromOffset(L.tbW, L.tbH)
	bar.Size = UDim2.fromOffset(L.natural, L.barH)
	barScale.Scale = L.ts

	sidebar.Size = UDim2.fromOffset(L.sidebarW, L.totalH)
	explorer.Position = UDim2.fromOffset(0, 0)
	explorer.Size = UDim2.new(1, 0, 0, L.explH)
	props.Position = UDim2.fromOffset(0, L.explH + METRICS.Gap)
	props.Size = UDim2.new(1, 0, 0, L.propH)

	placeFromState()
	updateTab()
end

------------------------------ Controle de arraste ---------------------
-- Fontes de arraste: "header" (cabecalhos / Properties), "tab" (aba lateral)
-- e "list" (deslizar sobre a lista: so move o painel se o gesto for
-- horizontal; se for vertical, a lista rola normalmente).
local drag = {
	input = nil,
	source = "",
	startPos = Vector3.new(),
	startX = 0,
	moved = false,
	cancelled = false,
}

local function beginPointer(input, source)
	local t = input.UserInputType
	if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then
		return
	end
	if drag.input then
		return
	end
	drag.input = input
	drag.source = source
	drag.startPos = input.Position
	drag.startX = sidebar.Position.X.Offset
	drag.moved = false
	drag.cancelled = false
end

local function endPointer()
	if not drag.input then
		return
	end
	local moved, cancelled, source = drag.moved, drag.cancelled, drag.source
	drag.input = nil
	drag.moved = false
	drag.cancelled = false
	scroll.ScrollingEnabled = true

	if moved or cancelled then
		suppressTapUntil = os.clock() + 0.25
	end
	if moved then
		settle()
	elseif not cancelled and source == "tab" then
		toggleCollapsed()
	end
end

local function onInputChanged(input)
	local current = drag.input
	if not current or drag.cancelled then
		return
	end
	local isMouse = current.UserInputType == Enum.UserInputType.MouseButton1
		and input.UserInputType == Enum.UserInputType.MouseMovement
	local isTouch = current.UserInputType == Enum.UserInputType.Touch and input == current
	if not (isMouse or isTouch) then
		return
	end

	local pos = input.Position
	if not drag.moved then
		local dx, dy = pos.X - drag.startPos.X, pos.Y - drag.startPos.Y
		if math.max(math.abs(dx), math.abs(dy)) < CONFIG.TapSlop then
			return
		end
		suppressTapUntil = math.huge
		if drag.source == "list" and math.abs(dy) >= math.abs(dx) then
			drag.cancelled = true -- gesto vertical: deixa o ScrollingFrame rolar
			return
		end
		drag.moved = true
		if drag.source == "list" then
			scroll.ScrollingEnabled = false -- gesto horizontal: trava a rolagem
		end
		cancelTween()
		drag.startPos = pos
		drag.startX = sidebar.Position.X.Offset
		return
	end

	setX(drag.startX + (pos.X - drag.startPos.X) / L.scale)
end

local function onInputEnded(input)
	local current = drag.input
	if not current then
		return
	end
	local sameTouch = input == current
	local mouseUp = input.UserInputType == Enum.UserInputType.MouseButton1
		and current.UserInputType == Enum.UserInputType.MouseButton1
	if sameTouch or mouseUp then
		endPointer()
	end
end

----------------------------------------------------------------------
-- 8. LISTA DO EXPLORER (linhas, setas de expandir, selecao)
----------------------------------------------------------------------
local flat = {}
local selectedEntry = nil

local function refreshVisibility()
	for _, entry in ipairs(flat) do
		local visible = true
		local p = entry.parent
		while p do
			if not p.expanded then
				visible = false
				break
			end
			p = p.parent
		end
		entry.row.Visible = visible
	end
end

local function toggleEntry(entry)
	if os.clock() < suppressTapUntil then
		return
	end
	entry.expanded = not entry.expanded
	entry.arrowRight.Visible = not entry.expanded
	entry.arrowDown.Visible = entry.expanded
	refreshVisibility()
end

local function selectEntry(entry)
	if os.clock() < suppressTapUntil then
		return
	end
	if selectedEntry then
		selectedEntry.row.BackgroundTransparency = 1
	end
	selectedEntry = entry
	entry.row.BackgroundTransparency = 0
end

local function buildRow(entry)
	local node = entry.node
	local pad = entry.depth * METRICS.Indent

	local row = create("TextButton", {
		Name = node.name,
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0,
		BackgroundColor3 = THEME.rowSelected,
		BackgroundTransparency = 1,
		LayoutOrder = entry.order,
		Size = UDim2.new(1, 0, 0, METRICS.RowH),
		Parent = scroll,
	})
	corner(row, 8)
	entry.row = row

	if entry.hasChildren then
		-- area de toque generosa para a seta (40 x 38)
		local arrowBtn = create("TextButton", {
			Name = "Arrow",
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(pad + 2, 0),
			Size = UDim2.fromOffset(40, METRICS.RowH),
			Parent = row,
		})
		local holder = create("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(16, 16),
			Parent = arrowBtn,
		})
		entry.arrowRight = buildIcon(holder, ToolIcons.ArrowRight, 16)
		entry.arrowDown = buildIcon(holder, ToolIcons.ArrowDown, 16)
		entry.arrowDown.Visible = false
		arrowBtn.Activated:Connect(function()
			toggleEntry(entry)
		end)
		arrowBtn.InputBegan:Connect(function(input)
			beginPointer(input, "list")
		end)
	end

	local iconHolder = create("Frame", {
		Name = "IconHolder",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, pad + 44, 0.5, 0),
		Size = UDim2.fromOffset(28, 28),
		Parent = row,
	})
	buildIcon(iconHolder, ItemIcons[node.icon] or ItemIcons.Generic, 28)

	create("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(pad + 82, 0),
		Size = UDim2.new(1, -(pad + 88), 1, 0),
		Text = node.name,
		Font = Enum.Font.GothamMedium,
		TextSize = 17,
		TextColor3 = THEME.text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	})

	row.Activated:Connect(function()
		selectEntry(entry)
	end)
	row.InputBegan:Connect(function(input)
		beginPointer(input, "list")
	end)
end

local function addNodes(nodes, depth, parentEntry)
	for _, node in ipairs(nodes) do
		local entry = {
			node = node,
			depth = depth,
			parent = parentEntry,
			expanded = false,
			hasChildren = node.children ~= nil and #node.children > 0,
		}
		table.insert(flat, entry)
		entry.order = #flat
		buildRow(entry)
		if entry.hasChildren then
			addNodes(node.children, depth + 1, entry)
		end
	end
end

----------------------------------------------------------------------
-- 9. LIGACOES E INICIALIZACAO
----------------------------------------------------------------------
addNodes(EXPLORER_TREE, 0, nil)
refreshVisibility()

explorerHeader.InputBegan:Connect(function(input)
	beginPointer(input, "header")
end)
propsHeader.InputBegan:Connect(function(input)
	beginPointer(input, "header")
end)
props.InputBegan:Connect(function(input)
	beginPointer(input, "header")
end)
tab.InputBegan:Connect(function(input)
	beginPointer(input, "tab")
end)
scroll.InputBegan:Connect(function(input)
	beginPointer(input, "list")
end)

UserInputService.InputChanged:Connect(onInputChanged)
UserInputService.InputEnded:Connect(onInputEnded)
UserInputService.WindowFocusReleased:Connect(endPointer)

gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(applyLayout)
applyLayout()
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
</roblox>
