	orange = Color3.fromRGB(255, 150, 30),
	orangeDark = Color3.fromRGB(224, 110, 0),
	orangeLight = Color3.fromRGB(255, 184, 77),
	red = Color3.fromRGB(240, 60, 60),
	gray = Color3.fromRGB(150, 160, 180),
	grayLight = Color3.fromRGB(200, 206, 218),
	grayDark = Color3.fromRGB(110, 120, 142),
