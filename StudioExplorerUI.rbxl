	buttonStroke = Color3.fromRGB(54, 62, 88),
	field = Color3.fromRGB(14, 20, 40),
	fieldStroke = Color3.fromRGB(40, 58, 112),
	divider = Color3.fromRGB(58, 66, 90),
	info = Color3.fromRGB(176, 200, 255),
}

