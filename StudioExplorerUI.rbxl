}

-- Medidas em "pixels de design" (a UI inteira e escalada por um UIScale)
local METRICS = {
	Margin = 8,
	Gap = 8,
	HeaderH = 46,
	RowH = 38,
	Indent = 22,
	TabW = 36,
	TabH = 96,
	BarFullH = 72,
